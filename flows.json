  {
    "id": "validate-command",
    "type": "function",
    "z": "tab-iot",
    "name": "Validar comando e encaminhar",
    "x": 640,
    "y": 610,
    "wires": [
      [
        "mqtt-command-out"
      ],
      [
        "http-command-out"
      ]
    ],
    "func": "let body = msg.payload;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch (e) { body = {command: body}; }\n}\nconst command = String((body && body.command) || '').trim().toUpperCase();\nif (!['ON','OFF','AUTO'].includes(command)) {\n  return [null, {statusCode:400, headers:{\"Content-Type\":\"application/json\"}, payload:{accepted:false,message:\"Comando inválido. Use ON, OFF ou AUTO.\"}}];\n}\nconst mqttMessage = {topic:\"monitoramento/esp32/actuator/command\", payload:command, qos:0, retain:false};\nconst httpMessage = {statusCode:202, headers:{\"Content-Type\":\"application/json\"}, payload:{accepted:true,command,message:\"Comando encaminhado ao broker MQTT.\"}};\nreturn [mqttMessage, httpMessage];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
