  {
    "id": "template-page",
    "type": "template",
    "z": "tab-iot",
    "name": "Página de monitoramento",
    "x": 420,
    "y": 400,
    "wires": [
      [
        "set-html-headers"
      ]
    ],
    "field": "payload",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Monitoramento IoT</title>\n<style>\n:root{font-family:system-ui,Arial,sans-serif;color:#17202a;background:#f3f6f9}body{margin:0;padding:24px}main{max-width:1100px;margin:auto}h1{margin:0 0 6px}.sub{color:#5b6570;margin:0 0 22px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}.card{background:white;border:1px solid #dce3ea;border-radius:12px;padding:18px;box-shadow:0 2px 8px #17202a0a}.label{font-size:13px;color:#5b6570}.value{font-size:30px;font-weight:700;margin-top:8px}.unit{font-size:14px;font-weight:500;color:#5b6570}.wide{margin-top:14px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}button{border:0;border-radius:8px;padding:11px 18px;font-weight:700;cursor:pointer;background:#e8eef5;color:#17202a}button:hover{filter:brightness(.96)}.on{background:#d7f2df}.off{background:#f8dddd}.auto{background:#dce9fa}canvas{width:100%;height:160px;border:1px solid #e2e8ef;border-radius:8px}.status{margin-top:12px;color:#5b6570;font-size:13px}.error{color:#a32626}.small{font-size:12px;color:#5b6570}\n</style>\n</head>\n<body><main>\n<h1>Monitoramento IoT — ESP32</h1><p class=\"sub\">Telemetria MQTT e controle remoto de atuadores por Node-RED.</p>\n<section class=\"grid\">\n <article class=\"card\"><div class=\"label\">Temperatura</div><div class=\"value\" id=\"temp\">— <span class=\"unit\">°C</span></div></article>\n <article class=\"card\"><div class=\"label\">Umidade do ar</div><div class=\"value\" id=\"hum\">— <span class=\"unit\">%</span></div></article>\n <article class=\"card\"><div class=\"label\">Umidade do solo</div><div class=\"value\" id=\"soil\">— <span class=\"unit\">%</span></div><div class=\"small\" id=\"soilraw\">ADC: —</div></article>\n <article class=\"card\"><div class=\"label\">Modo dos atuadores</div><div class=\"value\" id=\"mode\">—</div><div class=\"small\" id=\"actuators\">LED: — | Buzzer: —</div></article>\n</section>\n<section class=\"card wide\"><strong>Sinal do AD8232 — último lote recebido</strong><p class=\"small\">Visualização das amostras brutas; não representa diagnóstico nem interpretação clínica.</p><canvas id=\"ecg\" width=\"1000\" height=\"160\"></canvas><div class=\"small\" id=\"ecgmeta\">Aguardando lote de ECG...</div></section>\n<section class=\"card wide\"><strong>Comandos dos atuadores</strong><div class=\"actions\"><button class=\"on\" onclick=\"sendCommand('ON')\">Ligar (ON)</button><button class=\"off\" onclick=\"sendCommand('OFF')\">Desligar (OFF)</button><button class=\"auto\" onclick=\"sendCommand('AUTO')\">Automático (AUTO)</button></div><div class=\"status\" id=\"message\">Aguardando dados...</div></section>\n<p class=\"small\">A leitura de ECG é experimental e este protótipo não é equipamento médico. Atualização automática a cada 1,5 segundo.</p>\n</main>\n<script>\nconst byId=id=>document.getElementById(id);\nfunction fmt(v,d=1){return (v===null||v===undefined||Number.isNaN(Number(v)))?'—':Number(v).toFixed(d)}\nfunction drawEcg(samples){const c=byId('ecg'),ctx=c.getContext('2d');ctx.clearRect(0,0,c.width,c.height);ctx.strokeStyle='#d8e1ea';ctx.lineWidth=1;ctx.beginPath();for(let y=20;y<c.height;y+=20){ctx.moveTo(0,y);ctx.lineTo(c.width,y)}ctx.stroke();if(!Array.isArray(samples)||samples.length<2)return;let min=Math.min(...samples),max=Math.max(...samples);if(max===min)max=min+1;ctx.strokeStyle='#1769aa';ctx.lineWidth=2;ctx.beginPath();samples.forEach((v,i)=>{const x=i*c.width/(samples.length-1),y=c.height-12-(Number(v)-min)*(c.height-24)/(max-min);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)});ctx.stroke()}\nasync function refresh(){try{const r=await fetch('/api/estado',{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const s=await r.json();const e=s.environment||{};const a=s.actuators||{};const g=s.ecg||{};byId('temp').innerHTML=fmt(e.temperature_c)+' <span class=\"unit\">°C</span>';byId('hum').innerHTML=fmt(e.humidity_pct)+' <span class=\"unit\">%</span>';byId('soil').innerHTML=fmt(e.soil_pct)+' <span class=\"unit\">%</span>';byId('soilraw').textContent='ADC: '+(e.soil_raw??'—')+' | Alarme de solo seco: '+(a.soil_dry_alarm?'sim':'não');byId('mode').textContent=a.mode||'—';byId('actuators').textContent='LED: '+(a.led?'ligado':'desligado')+' | Buzzer: '+(a.buzzer?'ligado':'desligado');if(g.samples){drawEcg(g.samples);byId('ecgmeta').textContent='Lote: '+(g.sequence??'—')+' | Taxa: '+(g.sample_rate_hz??'—')+' Hz | Latência aproximada de recebimento: '+(g.latency_ms??'—')+' ms'}byId('message').textContent='Última atualização: '+new Date().toLocaleTimeString();}catch(e){byId('message').textContent='Falha ao consultar dados: '+e.message;byId('message').className='status error'}}\nasync function sendCommand(command){try{const r=await fetch('/api/comando',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command})});const b=await r.json();byId('message').textContent=b.message||('Comando '+command+' enviado.');if(!r.ok)throw new Error(b.message||'Falha');}catch(e){byId('message').textContent='Erro ao enviar comando: '+e.message;byId('message').className='status error'}}\nrefresh();setInterval(refresh,1500);\n</script></body></html>",
    "output": "str",
    "xss": false,
    "property": "payload"
  },
